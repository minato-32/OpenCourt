# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Paseo Asset Hub Next testnet deployer.

# Funded SS58 deployer address (public).
DEPLOYER_ADDRESS=

# sr25519 seed phrase for the deployer. TESTNET DEV WALLET ONLY — never mainnet, never real funds.
DEPLOYER_MNEMONIC=

# Endpoints (defaults match p2p-market).
PASEO_ETH_RPC_URL=https://eth-rpc-paseo-next.polkadot.io
PASEO_ASSET_HUB_WSS=wss://paseo-asset-hub-next-rpc.polkadot.io

# Already-deployed ZKPassportRegistry (the PoP gate). Fill once known.
ZKPASSPORT_REGISTRY_ADDRESS=
